// Resources for the single-file launcher.
//
// Compiled from the staging directory that tool\build_single_exe.ps1 fills, so
// every path here is a bare filename: sfx_version.h is generated per build, and
// app_icon.ico and payload.cab are copied in beside it.

#include <windows.h>
#include "sfx_version.h"

// Icon. Id 1 so Explorer picks it as the executable's icon — the shell uses the
// lowest-numbered ICON resource.
1 ICON "app_icon.ico"

// asInvoker keeps Windows from applying installer heuristics to an executable
// that unpacks things, which would otherwise prompt for elevation. The app is
// entirely per-user and needs no administrator rights.
1 RT_MANIFEST "sfx.manifest"

// The packed application. Id must match kPayloadResourceId in sfx_stub.cpp.
101 RCDATA "payload.cab"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SFX_VERSION_CSV
 PRODUCTVERSION SFX_VERSION_CSV
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "encore for rocksky contributors"
            VALUE "FileDescription", "encore for rocksky"
            VALUE "FileVersion", SFX_VERSION_STR
            VALUE "InternalName", "encore_for_rocksky"
            VALUE "LegalCopyright", "Licensed under the GNU GPL v3"
            VALUE "OriginalFilename", "encore-for-rocksky.exe"
            VALUE "ProductName", "encore for rocksky"
            VALUE "ProductVersion", SFX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
